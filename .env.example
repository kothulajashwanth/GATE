# ------------------------------------------------------------------
# ExamShield AI - Production & Development Environment Template
# Copy to .env for local runtime configuration
# ------------------------------------------------------------------

# ---- Database (Render PostgreSQL / Local) ----
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Object Storage ----
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=examshield
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key

# ---- API Configuration ----
API_URL=http://localhost:8000
API_VERSION=v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Security ----
SECRET_KEY=your_random_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ---- Clerk Authentication ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_SIGNING_SECRET=your_clerk_signing_secret
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---- AI Providers ----
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=openai

# ---- Email Service ----
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=ExamShield <no-reply@yourdomain.com>

# ---- Frontend Web Application ----
NEXT_PUBLIC_API_URL=http://localhost:8000
