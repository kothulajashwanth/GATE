# ------------------------------------------------------------------
# ExamShield AI - Environment Variables
# Copy to .env (root) and to apps/web/.env.local, apps/api/.env
# ------------------------------------------------------------------

# ---- Database (local: docker compose up -d postgres) ----
DATABASE_URL=postgresql+asyncpg://examshield:examshield_dev@localhost:5432/examshield

# ---- Redis (local: docker compose up -d redis) ----
REDIS_URL=redis://localhost:6379/0

# ---- Storage (local: docker compose up -d minio, S3-compatible; prod: Supabase Storage) ----
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=examshield
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=examshield
STORAGE_SECRET_KEY=examshield_dev

# ---- API ----
API_URL=http://localhost:8000
API_VERSION=v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ---- Clerk (Auth) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YXJ0aXN0aWMtd2Fob28tODMuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_I9n1EPx1BuCTZhQkEXdaaR4L5Uu0See2tCo9MKH1oZ
