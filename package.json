{
  "name": "examshield-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ExamShield AI - Enterprise Secure Online Examination Management System",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "npx pnpm --filter @examshield/web dev",
    "build": "npx pnpm --filter @examshield/web build",
    "lint": "npx pnpm -r lint",
    "typecheck": "npx pnpm -r typecheck",
    "test": "npx pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:dev": "cd apps/api && uvicorn app.main:app --reload --port 8000",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "next": "^16.3.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
