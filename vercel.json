{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx pnpm --filter @examshield/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npx pnpm install",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://examshield-api.up.railway.app/api/v1/:path*"
    }
  ]
}
