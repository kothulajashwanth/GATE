# ---- Environment ----
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://examshield:examshield_dev@localhost:5432/examshield

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Storage ----
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=examshield
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=examshield
STORAGE_SECRET_KEY=examshield_dev

# ---- Security ----
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ---- Clerk ----
CLERK_SECRET_KEY=
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=

# ---- AI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=openai

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM=ExamShield <no-reply@example.com>

# ---- Internal ----
API_INTERNAL_KEY=change-me-to-a-secret-shared-with-web
ALLOWED_ORIGINS=https://fabgate.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:5173
