{
  "name": "@examshield/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uvicorn app.main:app --reload --port 8000",
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "lint": "ruff check .",
    "format": "ruff format .",
    "test": "pytest tests/ -q",
    "db:migrate": "alembic upgrade head",
    "db:revision": "alembic revision --autogenerate",
    "db:seed": "python -m app.db.seed",
    "db:reset": "alembic downgrade base && alembic upgrade head && python -m app.db.seed",
    "typecheck": "mypy app"
  }
}
